# ==============================================================================
# OrionMapper - .gitignore
# ==============================================================================

# Agent & Tooling Metadata
.agents/
.gemini/

# Byte-compiled / optimized / C-extensions
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging / Build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing, Coverage & Linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
*.py,cover

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Ephemeral & Generated Orion Exports
data/orion_mappings/
data/audit_report.json
data/audit_recovery.json
data/audit_*.json
data/allcalidad/
# Unresolved backlog IS tracked: runners are ephemeral, so it must be
# committed to persist between scheduled runs.
data/unresolved/*
!data/unresolved/*.json

# Track Master Canonical Mappings
!data/mappings/movies.json
!data/mappings/series.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Logs and Databases
*.log
*.sqlite
*.sqlite3
*.db
